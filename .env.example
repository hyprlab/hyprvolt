# Copy to .env and adjust. Everything is optional: the app starts with none of
# it set. The last three are only seeded on a fresh install; after the setup
# wizard, Settings > Admin wins.

# What the app calls itself.
APP_NAME=Hyprprem
APP_TAGLINE=IT documentation for on-premise infrastructure.

# Which image to run: latest (stable), beta, or a version such as 1.4.0.
IMAGE_TAG=latest

# Session signing key. If unset, one is generated and kept in the data
# directory, so sessions survive a restart.
SECRET_KEY=

# Set to 1 when the app is served over HTTPS, so session cookies are Secure.
SESSION_COOKIE_SECURE=0

# How many reverse proxies sit in front of the app. 0 trusts no
# X-Forwarded-* header; a number higher than the real one lets clients spoof
# their address.
TRUST_PROXY=0

# Cloudflare Turnstile. Usually set up in the app instead, in Settings >
# Security, which checks the keys with a live challenge before saving them.
# Keys here are a fresh-install default; what is saved in the app wins.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ——— Fresh-install defaults ———
ALLOW_REGISTRATION=0
WORKER_MINUTES=15
ITEMS_PER_PAGE=40
